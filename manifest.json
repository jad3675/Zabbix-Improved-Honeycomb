{
	"manifest_version": 2.0,
	"id": "exceptionhoneycomb",
	"type": "widget",
	"name": "Exception honeycomb",
	"namespace": "ExceptionHoneycomb",
	"version": "1.0",
	"author": "",
	"description": "Honeycomb that only shows items whose latest value matches a condition.",
	"url": "",
	"widget": {
		"size": {
			"width": 24,
			"height": 5
		},
		"js_class": "CWidgetExceptionHoneycomb",
		"in": {
			"hostids": {
				"type": "_hostids"
			},
			"groupids": {
				"type": "_hostgroupids"
			}
		},
		"out": [
			{
				"type": "_hostid"
			},
			{
				"type": "_hostids"
			},
			{
				"type": "_itemid"
			},
			{
				"type": "_itemids"
			}
		]
	},
	"actions": {
		"widget.exceptionhoneycomb.view": {
			"class": "WidgetView"
		}
	},
	"assets": {
		"css": ["widget.css"],
		"js": ["class.svgexceptionhoneycomb.js", "class.widget.js"]
	}
}
